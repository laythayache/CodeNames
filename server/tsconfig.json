{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "rootDirs": ["./src", "../shared"],
    "paths": {
      "shared/types": ["../shared/types"]
    }
  },
  "include": ["src/**/*", "../shared/**/*"]
}
